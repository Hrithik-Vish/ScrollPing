    {
    "label": "Docker: Run Current Python File",
    "type": "process",
    "command": "docker",
    "args": [
        "exec",
        "-w",
        "/app",
        "scrollping-dev",
        "python",
        "-c",
        "import runpy, sys; from pathlib import Path; runpy.run_path(str(Path('/app') / sys.argv[1].replace(chr(92), '/')), run_name='__main__')",
        "${relativeFile}"
