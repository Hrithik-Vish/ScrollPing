# Copy this file to .env (git-ignored) and fill in the values. Never commit a real .env.
# The same names are used as GitHub Actions repository secrets (scraper) and Render environment
# variables (bot). See docs/deployment.md.

# ---- Supabase (scraper and bot) --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Required at import by database.py; not otherwise used yet (any non-empty value works).
SUPABASE_PUBLISHABLE_KEY=
# The service key: it bypasses Row Level Security. Server-side only, never in a client.
SUPABASE_SECRET_KEY=

# ---- Telegram (scraper alerts and the bot) ---------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids that receive site-failure alerts and the daily digest, e.g.
# 123456789,987654321. Leave empty to switch both off. Ask @userinfobot for your own id.
ADMIN_TELEGRAM_USER_IDS=

# ---- Bot hosting (optional) ------------------------------------------------------------------
# Port for the bot's /health page. Render sets PORT itself; locally leave both unset (no port opens).
# HEALTH_PORT=10000

# ---- Manual smoke tests only (tests/test_smokeTest.py, tests/test_live_database_smoke.py) ----
# Your own chat id: the smoke test sends real messages there.
TELEGRAM_CHAT_ID=
# Any real user and novel id from your database (for the live database smoke test).
SMOKE_USER_ID=
SMOKE_NOVEL_ID=
# The smoke tests run only when RUN_SMOKE_TESTS=1 is set in the SHELL (not here):
#   RUN_SMOKE_TESTS=1 python -m pytest tests/test_smokeTest.py -v -s
